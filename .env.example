# Hvor leads sendes videre. Uten denne kjører /api/lead i tørrmodus (logger bare).
# Smart Elektro Sol: https://smartelektrosol.no/api/leads/create
LEADS_API_URL=

# Domener som får vise appen i iframe (mellomromsseparert). Standard: se next.config.ts
FRAME_ANCESTORS=

# Søknadsfrister: hentes automatisk fra Enova én gang i døgnet.
# Manuell korrigering (overstyrer hentingen), kl. 12.00 norsk tid: 2027-02-03, 2027-06-03
ENOVA_DEADLINES=
# Varsel ved hentefeil (f.eks. en Slack-webhook)
DEADLINES_ALERT_WEBHOOK=
